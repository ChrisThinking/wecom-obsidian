{
  "name": "dsh-wecom-obsidian",
  "version": "1.0.0",
  "description": "Agent-powered bridge that turns links shared in WeCom into structured, local-first knowledge in Obsidian.",
  "keywords": [
    "wecom",
    "wechat-work",
    "obsidian",
    "ai-agent",
    "automation",
    "knowledge-management",
    "local-first",
    "web-clipping",
    "knowledge-base",
    "dsh"
  ],
  "license": "MIT",
  "author": "ChrisThinking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisThinking/wecom-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/ChrisThinking/wecom-obsidian/issues"
  },
  "homepage": "https://github.com/ChrisThinking/wecom-obsidian#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "client/**/*.js",
    "bundle/**",
    "pipeline/**",
    "install/**",
    "tests/**",
    "docs/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:plugin": "bash install/install.sh",
    "uninstall:plugin": "bash install/uninstall.sh",
    "check": "npm run test",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s pipeline/tests -t pipeline/tests",
    "test:js": "node --test tests/*.test.mjs",
    "test:py": "python3 -m unittest discover -s pipeline/tests -t pipeline/tests -v"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
